### Как использовать
# Скопируйте этот файл в .env и поменяйте значения:
# Windows: copy .env.example .env

### Подключение к Postgres (используется docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg

# Строка подключения, которую использует само приложение
DATABASE_URL=postgresql://postgres:postgres@db:5432/tg

PORT=3000

### Telegram bot token and roles
BOT_TOKEN=your_bot_token_here
STAROSTA_ID=0
DEPUTY_STAROSTA_IDS=
DEBUG_IDS=
ADMIN_IDS=

### Group size for bets
GROUP_SIZE=28