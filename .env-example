### How to use
# Copy this file to .env and change the values:
# Windows: copy .env.example .env

### PostgreSQL connection (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg

# Connection string used by the application
DATABASE_URL=postgresql://postgres:postgres@db:5432/tg

PORT=3000

### Telegram bot token and roles
BOT_TOKEN=your_bot_token_here
STAROSTA_ID=0
DEPUTY_STAROSTA_IDS=
DEBUG_IDS=
ADMIN_IDS=

### Group size for bets
GROUP_SIZE=28